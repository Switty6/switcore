# =============================================================================
#  SwitCore - server.cfg.example
#  Copiaza acest fisier ca "server.cfg" si completeaza valorile marcate TODO
# =============================================================================

# -----------------------------------------------------------------------------
# METADATA SERVER
# -----------------------------------------------------------------------------
sv_hostname "SwitCore Server"          # Numele serverului in lista FiveM
sv_maxclients 32                        # Nr. maxim de jucatori

# TODO: cheia ta de licenta FiveM (https://portal.cfx.re/)
sv_licenseKey "YOUR_LICENSE_KEY_HERE"

# TODO: endpoint public daca serverul este online
# endpoint_add_tcp "0.0.0.0:30120"
# endpoint_add_udp "0.0.0.0:30120"

# OneSync - necesar pentru servere cu mai multi jucatori si sync avansat
set onesync on

# Limba serverului (ro/en). Toate mesajele si interfetele folosesc limba de aici.
# Replicat la clienti (setr) ca sa fie citibil si in loadscreen.
setr sw_locale "ro"

# Blocheaza ScriptHook in productie
set sv_scriptHookAllowed 0

# =============================================================================
# BAZA DE DATE SI PANOU SWITCORE
# Ruleaza setup.bat din resources/ inainte de prima pornire. El face npm install
# si creeaza config.local.js pentru:
#   resources/[switcore]/postgres/config.local.js         (conexiune baza de date)
#   resources/[switcore]/settings-panel/config.local.js   (panou web de setari)
# =============================================================================

# =============================================================================
# SISTEM - resurse Cfx.re implicite (pornesc primele)
# =============================================================================
ensure baseevents        # Evenimente de baza (kill, spawn, etc.)
ensure sessionmanager    # Gestioneaza sesiunile jucatorilor
# ensure sessionmanager-rdr3  # Foloseste DOAR pentru RedM in loc de sessionmanager
ensure hardcap           # Blocheaza conexiuni peste sv_maxclients
ensure rconlog           # Logheaza comenzile RCON

# Build tools (pentru resurse Node.js / TypeScript)
ensure yarn
ensure webpack

# Manageri harta si spawn
ensure mapmanager
ensure spawnmanager

# =============================================================================
# SWITCORE - toate modulele framework-ului pornite intr-un singur ensure
# -----------------------------------------------------------------------------
# IMPORTANT inainte de primul start:
#   1. cd resources/[switcore]/postgres && npm install
#   2. cd resources/[switcore]/settings-panel && npm install
#   3. Asigura-te ca PostgreSQL ruleaza si baza de date e creata
#      (vezi README.md - sectiunea "Instalare PostgreSQL")
#
# FXServer rezolva automat ordinea de pornire pe baza dependentelor declarate
# in fxmanifest-ul fiecarui modul. Modulele cu dependinte (banking, vehicles,
# police, etc.) vor astepta pornirea modulelor de fundatie (postgres, core).
# =============================================================================
ensure [switcore]

# =============================================================================
# GAMEPLAY general
# =============================================================================
ensure chat              # Chat (compilat cu yarn + webpack)
ensure playernames       # Afisare nume jucatori

# =============================================================================
# GAMEMODE
# =============================================================================
ensure basic-gamemode    # Mod de joc de baza (freeroam)

# =============================================================================
# DEVELOPMENT ONLY - decomenteaza DOAR in mediu local, NICIODATA in productie
# =============================================================================
# ensure runcode         # Executie cod arbitrar (PERICULOS in productie!)
